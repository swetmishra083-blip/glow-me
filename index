<script>

const products = [
    {
        id: 1,
        name: "Rose Glow Serum",
        category: "Skincare",
        price: 499,
        old: 699,
        image: "https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?w=600"
    },
    {
        id: 2,
        name: "Hydrating Face Cream",
        category: "Skincare",
        price: 599,
        old: 799,
        image: "https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?w=600"
    },
    {
        id: 3,
        name: "Pink Matte Lipstick",
        category: "Makeup",
        price: 399,
        old: 549,
        image: "https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=600"
    },
    {
        id: 4,
        name: "Luxury Perfume",
        category: "Perfume",
        price: 899,
        old: 1199,
        image: "https://images.unsplash.com/photo-1541643600914-78b084683601?w=600"
    },
    {
        id: 5,
        name: "Face Cleanser",
        category: "Skincare",
        price: 349,
        old: 499,
        image: "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600"
    },
    {
        id: 6,
        name: "Beauty Foundation",
        category: "Makeup",
        price: 699,
        old: 899,
        image: "https://images.unsplash.com/photo-1631214524020-7e18db9a8f92?w=600"
    },
    {
        id: 7,
        name: "Hair Care Oil",
        category: "Haircare",
        price: 299,
        old: 399,
        image: "https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?w=600"
    },
    {
        id: 8,
        name: "Soft Body Lotion",
        category: "Skincare",
        price: 449,
        old: 599,
        image: "https://images.unsplash.com/photo-1601049541289-9b1b7bbbfe19?w=600"
    }
];

let cart = JSON.parse(localStorage.getItem("glowCart") || "[]");
let wishlist = JSON.parse(localStorage.getItem("glowWishlist") || "[]");
let currentCategory = "All";

function renderProducts() {
    const search = document.getElementById("search").value.toLowerCase();

    const filtered = products.filter(p =>
        (currentCategory === "All" || p.category === currentCategory) &&
        p.name.toLowerCase().includes(search)
    );

    document.getElementById("products").innerHTML =
        filtered.length ? filtered.map(p => `
        <div class="product">
            <div class="product-img">
                <img src="${p.image}" alt="${p.name}"
                onerror="this.style.display='none'">
                <button class="wish-btn ${wishlist.includes(p.id) ? 'active' : ''}"
                onclick="toggleWish(${p.id})">
                    ${wishlist.includes(p.id) ? '♥' : '♡'}
                </button>
            </div>

            <div class="product-info">
                <h3>${p.name}</h3>
                <p>${p.category}</p>
                <div class="price">
                    ₹${p.price}
                    <span class="old-price">₹${p.old}</span>
                </div>
                <button class="add-btn"
                onclick="addCart(${p.id})">
                    + ADD TO CART
                </button>
            </div>
        </div>
        `).join("") :
        "<p>No products found. Try another search.</p>";
}

function setCategory(category, button) {
    currentCategory = category;

    document.querySelectorAll(".filter-btn").forEach(btn =>
        btn.classList.remove("active")
    );

    if (button) {
        button.classList.add("active");
    } else {
        document.querySelectorAll(".filter-btn").forEach(btn => {
            if (btn.textContent.trim() === category) {
                btn.classList.add("active");
            }
        });
    }

    document.getElementById("search").value = "";
    renderProducts();

    document.getElementById("shop").scrollIntoView({
        behavior: "smooth"
    });
}

function saveCart() {
    localStorage.setItem("glowCart", JSON.stringify(cart));
    updateCart();
}

function addCart(id) {
    const item = cart.find(p => p.id === id);

    if (item) {
        item.qty++;
    } else {
        cart.push({id: id, qty: 1});
    }

    saveCart();
    showToast("Product added to your bag! 💗");
}

function removeCart(id) {
    cart = cart.filter(p => p.id !== id);
    saveCart();
}

function updateCart() {
    const count = cart.reduce((sum, p) => sum + p.qty, 0);
    document.getElementById("cartCount").innerText = count;

    const container = document.getElementById("cartItems");

    if (cart.length === 0) {
        container.innerHTML = '<div class="empty">Your bag is empty 🛍️</div>';
    } else {
        container.innerHTML = cart.map(item => {
            const p = products.find(x => x.id === item.id);

            return `
            <div class="cart-item">
                <img src="${p.image}" alt="${p.name}">
                <div class="cart-item-info">
                    <strong>${p.name}</strong>
                    <p>₹${p.price} × ${item.qty}</p>
                    <button onclick="changeQty(${p.id},-1)">−</button>
                    <span>${item.qty}</span>
                    <button onclick="changeQty(${p.id},1)">+</button>
                </div>
                <button class="remove-btn"
                onclick="removeCart(${p.id})">Remove</button>
            </div>
            `;
        }).join("");
    }

    const total = cart.reduce((sum, item) => {
        const p = products.find(x => x.id === item.id);
        return sum + p.price * item.qty;
    }, 0);

    document.getElementById("cartTotal").innerText =
        "Total: ₹" + total;
}

function changeQty(id, amount) {
    const item = cart.find(p => p.id === id);

    if (!item) return;

    item.qty += amount;

    if (item.qty <= 0) {
        cart = cart.filter(p => p.id !== id);
    }

    saveCart();
}

function toggleWish(id) {
    if (wishlist.includes(id)) {
        wishlist = wishlist.filter(x => x !== id);
        showToast("Removed from wishlist");
    } else {
        wishlist.push(id);
        showToast("Added to wishlist ♥");
    }

    localStorage.setItem("glowWishlist", JSON.stringify(wishlist));
    renderProducts();
}

function openCart() {
    document.getElementById("cartPanel").classList.add("show");
    document.getElementById("overlay").classList.add("show");
}

function closeCart() {
    document.getElementById("cartPanel").classList.remove("show");
    document.getElementById("overlay").classList.remove("show");
}

function showToast(message) {
    const toast = document.getElementById("toast");
    toast.innerText = message;
    toast.classList.add("show");

    setTimeout(() => toast.classList.remove("show"), 2200);
}

function checkout() {
    if (cart.length === 0) {
        showToast("Your shopping bag is empty!");
        return;
    }

    alert("Thank you for shopping at Glow Me! This is a demo checkout. Online payment is not connected yet.");
}

function subscribe(event) {
    event.preventDefault();
    showToast("Thank you for subscribing! 💗");
    document.getElementById("email").value = "";
}

renderProducts();
updateCart();

</script>
